{
    // R3BL Extension Pack: https://github.com/r3bl-org/r3bl-vscode-extensions
    "copyrighter.author": "R3BL LLC",
    "copyrighter.license": "Apache2OneLine",
    "search.exclude": {
        "**/test_data/**": true,
        "task/done/**": true
    },
    "rust-analyzer.cargo.target": "x86_64-unknown-linux-gnu",
    // Harper grammar & spell checker settings.
    "harper.workspaceDictPath": "./.harper-dictionary.txt",
    "harper.linters.RightClick": false,
    "harper.linters.WereWhere": false,
    "harper.linters.DisjointPrefixes": false,
    "harper.linters.SimplePastToPastParticiple": false,
    "harper.linters.DotInitialisms": false,
    "harper.linters.InflectedVerbAfterTo": false,
    "harper.linters.ToTwoToo": false,
    "harper.linters.NoFrenchSpaces": false,
    "harper.linters.PhrasalVerbAsCompoundNoun": false,
    "harper.linters.LongSentences": false,
    "harper.linters.SplitWords": false,
    "harper.linters.MassNouns": false,
    "harper.linters.ExpandTimeShorthands": false,
    "harper.linters.ExpandControl": false,
    "harper.linters.UseEllipsisCharacter": false,
    "harper.linters.CompoundNouns": false,
    "harper.linters.ExpandStandardInputAndOutput": false,
    "harper.linters.SentenceCapitalization": false,
    "harper.linters.OrthographicConsistency": false,
    "harper.linters.ExpandConfiguration": false,
    "harper.linters.MissingDeterminer": false,
    "harper.linters.Spaces": false,
    "harper.linters.EllipsisLength": false,
    "harper.linters.NumericRangeEnDash": false,
    "harper.linters.Dashes": false,
    "harper.linters.UseTitleCase": false,
    "harper.linters.ExpandMemoryShorthands": false,
    "harper.excludePatterns": [
        "**/.harper-dictionary.txt",
        "**/task/**",
        "**/task/done/**"
    ]
}
